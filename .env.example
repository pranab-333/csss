# ------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ------------------------------------------------------------------

# Base URL of your Node.js/Express backend API.
# Example (local dev backend running on port 5000):
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: name of the JWT/token key stored in localStorage.
VITE_AUTH_TOKEN_KEY=dmalpot_auth_token
